PORT=3000
# Shared secret that must appear in every TradingView alert's JSON body.
# Set this to a long random value and keep it out of source control.
TRADINGVIEW_WEBHOOK_SECRET=change-me

# --- Position sizing for FX alerts (see strategy/README.md) ---------------
# Account equity in EUR and the fraction of it risked per trade.
ACCOUNT_EQUITY_EUR=500
RISK_PER_TRADE=0.01
# Your broker's smallest tradeable size and volume step, in units of the base
# currency. 100 = 0.001 lots ("nano"), 1000 = 0.01 lots ("micro"). A 500 EUR
# account generally needs 100 here; at 1000 most signals are refused because
# the smallest legal trade would risk 2-4% of the account.
LOT_STEP_UNITS=100
MIN_UNITS=100
MAX_LEVERAGE=30
# Units of each currency per EUR, used to convert quote-currency risk into EUR.
# Refresh occasionally; lot rounding moves the result more than a stale rate.
QUOTE_RATES_JSON={"USD":1.09,"JPY":158,"GBP":0.85,"CHF":0.94,"CAD":1.48,"AUD":1.63,"NZD":1.79}
